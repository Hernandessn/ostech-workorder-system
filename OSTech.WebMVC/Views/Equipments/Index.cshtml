@model IEnumerable<EquipmentViewModel>

<h2>Equipamentos</h2>

<hr />

<div class="row">
    <div class="col-md-12">
        <div class="pull-left">
            <a asp-action="CreateNewEquipment" class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Equipamento
            </a>
        </div>
    </div>
</div>

<br />

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Brand)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SerialNumber)
            </th>
            <th width="150"></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Brand)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Model)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.SerialNumber)
                </td>

                <td>
                    <a asp-action="UpdateEquipment"
                       asp-route-id="@item.EquipmentId"
                       class="btn btn-warning btn-sm"
                       title="Editar">
                        <i class="fas fa-edit"></i>
                    </a>

                    <a asp-action="DeleteEquipment"
                       asp-route-id="@item.EquipmentId"
                       class="btn btn-danger btn-sm"
                       title="Excluir">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>