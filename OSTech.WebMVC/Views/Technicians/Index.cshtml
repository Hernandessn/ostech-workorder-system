@model IEnumerable<TechnicianViewModel>

<h2>Técnicos</h2>

<hr />

<div class="row">
    <div class="col-md-12">
        <div class="pull-left">
            <a asp-action="CreateNewTechnician" class="btn btn-primary">
                <span class="fas fa-plus"></span> Novo Técnico
            </a>
        </div>
    </div>
</div>

<br />

<div class="panel panel-default">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Specialty)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contact)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Availability)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HiringDate)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Specialty)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Contact)
                    </td>

                    <td>
                        @if (item.Availability)
                        {
                            <span class="badge bg-success">Disponível</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Indisponível</span>
                        }
                    </td>

                    <td>
                        @item.HiringDate.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        <a asp-action="UpdateTechnician"
                           asp-route-id="@item.TechnicianId"
                           class="btn btn-warning"
                           title="Editar">
                            <span class="fas fa-edit"></span>
                        </a>

                        <a asp-action="DeleteTechnician"
                           asp-route-id="@item.TechnicianId"
                           class="btn btn-danger"
                           title="Excluir">
                            <span class="fas fa-trash-alt"></span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>