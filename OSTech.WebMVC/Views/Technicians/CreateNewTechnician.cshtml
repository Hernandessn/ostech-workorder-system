@model TechnicianViewModel

<h2>Criar um Técnico</h2>

<form asp-action="CreateNewTechnician">
    <div class="form-horizontal">
        <hr />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name" class="col-md-2 control-label"></label>
            <div class="col-md-10">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Specialty" class="col-md-2 control-label"></label>
            <div class="col-md-10">
                <input asp-for="Specialty" class="form-control" />
                <span asp-validation-for="Specialty" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Contact" class="col-md-2 control-label"></label>
            <div class="col-md-10">
                <input asp-for="Contact" class="form-control" />
                <span asp-validation-for="Contact" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="HiringDate" class="col-md-2 control-label"></label>
            <div class="col-md-10">
                <input asp-for="HiringDate" type="date" class="form-control" />
                <span asp-validation-for="HiringDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group" style="padding-top:10px">
            <div class="col-md-10 offset-md-2">
                <div class="form-check">
                    <input asp-for="Availability" class="form-check-input" />
                    <label asp-for="Availability" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="form-group" style="padding-top:10px">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Criar" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-info">Retornar</a>
            </div>
        </div>

        @if (ViewBag.Erro != null)
        {
            <div style="color:red">
                <h4>@ViewBag.Erro</h4>
            </div>
        }
    </div>
</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}